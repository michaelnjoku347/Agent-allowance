# Agent wallet private key. This wallet signs vouchers.
# Register the address at https://hackathon.ap4m.build/participant
# and fund it with test XRP from https://faucet.testevm.ripple.com
# Never commit a real key. .env is gitignored.
AGENT_PRIVATE_KEY=

# AP4M hackathon service.
AP4M_API_URL=https://hackathon.ap4m.build

# Team name, exactly as registered on the participant portal.
TEAM_NAME=

# Open Channel to spend from. Leave blank to reuse an open Channel, or to open one.
CHANNEL_ID=

# Merchant payout address. RLUSD is paid here. Copy it into
# agent/rules.json allowedMerchants or the agent saves the quote instead of paying.
# Do not commit your real address if you add it only on your machine.
MERCHANT_PAYOUT_ADDRESS=

# URL the agent calls. The local merchant sells market data here.
RESOURCE_URL=http://127.0.0.1:4308/resource

# Merchant process. From the participant portal. The submitter wallet needs test XRP for gas.
# Never commit a real key.
MERCHANT_ID=
MERCHANT_SUBMITTER_KEY=

# With MERCHANT_PAYOUT_ADDRESS, MERCHANT_ID, and MERCHANT_SUBMITTER_KEY set,
# npm start runs the merchant too. 0 leaves it to you (npm run merchant).
# START_MERCHANT=1

# Price of GET /resource. Keep it at or under the 0.05 RLUSD per-purchase cap
# in agent/rules.json so the demo's first purchase is allowed.
# PRICE_RLUSD=0.01

# Merchant listen port. This is not PORT (that is the allowance API).
# MERCHANT_PORT=4308

# Second x402 resource: extended market history at 0.08 RLUSD, same payout.
# It is over the cap on purpose, so it waits for a Ledger approval.
# The merchant process listens for it on HISTORY_PORT. 4318 avoids the other
# local demo, which uses 4309. Any HTTP answer, including 402, means it is up.
# HISTORY_PORT=4318
# HISTORY_RESOURCE_URL=http://127.0.0.1:4318/resource
# HISTORY_STATE_DIRECTORY=merchant/state-history

# State-changing POSTs must come from the dashboard origin. The API also
# refuses a Host that is not localhost or 127.0.0.1.
# DASHBOARD_ORIGIN=http://127.0.0.1:5173

# Optional. RLUSD cap when this agent opens a new Channel. Defaults to the rules
# budget (0.20). A cap the size of the channel-cap test (0.05, or 5 from older
# setups) is replaced by that budget during setup. Do not leave a test channel
# open; the demo will not reuse a channel below the budget. Check the channel
# limits per budget deposit in https://hackathon.ap4m.build/llms.txt.
# CHANNEL_CAP=0.20

# Local API the dashboard polls.
PORT=8787

# Ethereum address of the Ledger account that approves an out-of-rule purchase.
# Account m/44'/60'/0'/0/0 in the Ethereum app. Public address only — never a key.
# This overrides approverAddress in the rules file when both are set.
# APPROVER_ADDRESS=

# Optional. Defaults to agent/rules.json. setup:payments writes the real payout there.
# ALLOWANCE_RULES=agent/rules.json

# Optional isolated merchant database when another local demo uses the default.
# MERCHANT_STATE_DIRECTORY=merchant/state-local

# Jev reviews an allowed purchase before it is paid. Leave the key blank to
# use the rules only. Create a key at https://thejevai.com (account settings, API Keys).
# A self-hosted Kev server uses the same API. Put its URL in JEV_API_URL.
JEV_API_KEY=
JEV_API_URL=https://thejevai.com
JEV_MODEL=typesafe/jev-1.13

# Optional. Eve uses an OpenAI-compatible chat API when these are set.
# Keys stay on the server. They are never sent to the browser.
# Bedrock, when configured below, answers before this fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional. Amazon Bedrock rewords Eve's replies and writes the agent's purchase plan.
# The allowance rules and Jev still decide whether a quote is paid.
# Leave these blank to keep the built-in Eve parser and the rules-only plan.
# Region: AWS_REGION, or AWS_DEFAULT_REGION when AWS_REGION is blank.
# Auth: a Bedrock API key, or standard access keys. A bearer token wins if both are set.
# Never commit a real key. .env is gitignored.
AWS_REGION=
BEDROCK_MODEL_ID=
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


# Optional. Scales the API's per-client rate limits (1 = default, 0 = off for a local load test).
# ALLOWANCE_RATE_LIMIT=1

# Hosted public demo only. See docs/DEPLOY.md. Leave these unset on your computer.
# PUBLIC_DEMO=1
# PUBLIC_DEMO_PAYMENTS=simulated
# PUBLIC_HOSTNAME=demo.example.com
# HOST=0.0.0.0
