{
  "name": "agent-allowance",
  "private": true,
  "type": "module",
  "description": "A spending account for AI agents, with rules enforced before each AP4M x402 payment.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "agent": "node agent/agent.js",
    "server": "node server/index.js",
    "dashboard": "npm --prefix dashboard run dev",
