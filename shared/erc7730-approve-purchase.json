{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v1.schema.json",
  "context": {
    "eip712": {
      "domain": {
        "name": "Agent Allowance",
        "version": "1",
        "chainId": 1449000
      }
    }
  },
  "metadata": {
    "owner": "Agent Allowance",
    "info": {
      "legalName": "Agent Allowance",
      "url": "https://hackathon.ap4m.build"
    }
  },
  "display": {
    "formats": {
      "ApprovePurchase(string purchaseId,string merchant,string amount,string expiry)": {
        "intent": "Approve purchase",
        "fields": [
          { "path": "purchaseId", "label": "Purchase", "format": "raw" },
          { "path": "merchant", "label": "Merchant", "format": "raw" },
          { "path": "amount", "label": "Amount", "format": "raw" },
          { "path": "expiry", "label": "Expires", "format": "raw" }
        ]
      },
      "SetAllowance(string cap,string budget,string expiry,string merchants,string validUntil)": {
        "intent": "Set allowance",
        "fields": [
          { "path": "cap", "label": "Cap", "format": "raw" },
          { "path": "budget", "label": "Budget", "format": "raw" },
          { "path": "expiry", "label": "Allowance expires", "format": "raw" },
          { "path": "merchants", "label": "Merchants", "format": "raw" },
          { "path": "validUntil", "label": "Signature expires", "format": "raw" }
        ]
      }
    }
  }
}
